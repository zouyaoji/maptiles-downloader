{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "checkJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules"]
}
