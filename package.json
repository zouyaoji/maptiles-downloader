{
  "name": "bing-map",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "download_msn_street_world": "node ./src/maptiles-downloader.mjs --type=msn_street_world",
    "download_msn_street_china": "node ./src/maptiles-downloader.mjs --type=msn_street_china",
    "download_msn_street_province": "node ./src/maptiles-downloader.mjs --type=msn_street_province",
    "download_msn_image_world": "node ./src/maptiles-downloader.mjs --type=msn_image_world",
    "download_msn_image_china": "node ./src/maptiles-downloader.mjs --type=msn_image_china",
    "download_msn_image_pakistan": "node ./src/maptiles-downloader.mjs --type=msn_image_pakistan",
    "download_msn_image_shaoguan": "node ./src/maptiles-downloader.mjs --type=msn_image_shaoguan",
    "merge_msn_image_shaoguan": "node ./src/maptiles-to-tif.mjs --mbtiles=./output/msn_image_shaoguan_13_14.mbtiles --out=./output/msn_image_shaoguan.tif --zoom=14",
    "merge_msn_image_shaoguan_overview": "node ./src/maptiles-to-tif.mjs --mbtiles=./output/msn_image_shaoguan_13_14.mbtiles --out=./output/msn_image_shaoguan_overview.tif --zoom=14,13",
    "download_merge_msn_image_shaoguan": "node ./src/maptiles-downloader.mjs --type=msn_image_shaoguan && node ./src/maptiles-to-tif.mjs --mbtiles=./output/msn_image_shaoguan_13_14.mbtiles --out=./output/msn_image_shaoguan.tif",
    "download_msn_image_province": "node ./src/maptiles-downloader.mjs --type=msn_image_province",
    "download_msn_image_yilong": "node ./src/maptiles-downloader.mjs --type=msn_image_yilong",
    "download_msn_shadow_world": "node ./src/maptiles-downloader.mjs --type=msn_shadow_world",
    "download_msn_shadow_china": "node ./src/maptiles-downloader.mjs --type=msn_shadow_china",
    "download_msn_shadow_province": "node ./src/maptiles-downloader.mjs --type=msn_shadow_province",
    "download_tianditu_vec_w_world": "node ./src/maptiles-downloader.mjs --type=tianditu_vec_w_world",
    "download_tianditu_vec_w_china": "node ./src/maptiles-downloader.mjs --type=tianditu_vec_w_china",
    "download_tianditu_vec_w_province": "node ./src/maptiles-downloader.mjs --type=tianditu_vec_w_province",
    "download_tianditu_img_w_world": "node ./src/maptiles-downloader.mjs --type=tianditu_img_w_world",
    "download_tianditu_img_w_china": "node ./src/maptiles-downloader.mjs --type=tianditu_img_w_china",
    "download_tianditu_img_w_shaoguan": "node ./src/maptiles-downloader.mjs --type=tianditu_img_w_shaoguan",
    "merge_tianditu_img_w_shaoguan": "node ./src/maptiles-to-tif.mjs --mbtiles=./output/tianditu_img_w_shaoguan_12.mbtiles --out=./output/tianditu_img_w_shaoguan.tif --zoom=12",
    "download_merge_tianditu_img_w_shaoguan": "node ./src/maptiles-downloader.mjs --type=tianditu_img_w_shaoguan && node ./src/maptiles-to-tif.mjs --mbtiles=./output/tianditu_img_w_shaoguan_12.mbtiles --out=./output/tianditu_img_w_shaoguan.tif --zoom=12",
    "download_tianditu_img_w_province": "node ./src/maptiles-downloader.mjs --type=tianditu_img_w_province",
    "download_tianditu_ter_w_world": "node ./src/maptiles-downloader.mjs --type=tianditu_ter_w_world",
    "download_tianditu_ter_w_china": "node ./src/maptiles-downloader.mjs --type=tianditu_ter_w_china",
    "download_tianditu_cia_w_pakistan": "node ./src/maptiles-downloader.mjs --type=tianditu_cia_w_pakistan",
    "download_amazonaws_ter_world": "node ./src/maptiles-downloader.mjs --type=amazonaws_ter_world",
    "download_amazonaws_ter_china": "node ./src/maptiles-downloader.mjs --type=amazonaws_ter_china",
    "download_amazonaws_ter_region_13_15": "node ./src/maptiles-downloader.mjs --type=amazonaws_ter_world --bbox 84.2,28.0,86.4,29.6 --min-z 13 --max-z 15 --out ./output/amazonaws_ter_region_13_15.mbtiles",
    "download_amazonaws_ter_region_0_15": "node ./src/maptiles-downloader.mjs --type=amazonaws_ter_world --bbox 84.2,28.0,86.4,29.6 --min-z 0 --max-z 15 --out ./output/amazonaws_ter_region_0_15.mbtiles",
    "extract-tiles": "node ./scripts/extract-tiles.mjs",
    "extract-tiles:region-mbtiles": "node ./scripts/extract-tiles.mjs --bbox 84.2,28.0,86.4,29.6 --mbtiles ./output/region.mbtiles",
    "extract-tiles:region-png": "node ./scripts/extract-tiles.mjs --bbox 84.2,28.0,86.4,29.6 --min-z 0 --max-z 12 --dir ./output/region_tiles",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "jpeg-js": "^0.4.4",
    "node-fetch": "^3.3.2",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@types/node": "^26.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.1.0"
  }
}
